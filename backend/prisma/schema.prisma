generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  role            Role
  complianceScore Int             @default(100)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clientLinks     ClientTrainer[]
  messages        Message[]
  plans           Plan?
  progress        Progress[]
  trainerProfile  Trainer?
  trainerRequests TrainerRequest[]
  conversations   Conversation[]  @relation("ConversationParticipants")
  fitnessGoal   FitnessGoal
  fitnessLevel  FitnessLevel
  activityType  ActivityType
  dietRecipeDetails DietRecipeDetail[]
}

model Trainer {
  id              String          @id @default(uuid())
  userId          String          @unique
  qualifications  String[]
  expertise       String[]
  experienceYears Int
  rating          Float?
  createdAt       DateTime        @default(now())
  clients         ClientTrainer[]
  requests        TrainerRequest[]
  user            User            @relation(fields: [userId], references: [id])
}

model TrainerRequest {
  id        String               @id @default(uuid())
  trainerId String
  userId    String
  status    TrainerRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  trainer   Trainer              @relation(fields: [trainerId], references: [id])
  user      User                 @relation(fields: [userId], references: [id])

  @@unique([trainerId, userId])
  @@index([trainerId, status])
  @@index([userId, status])
}

model ClientTrainer {
  id        String   @id @default(uuid())
  trainerId String
  userId    String
  createdAt DateTime @default(now())
  trainer   Trainer  @relation(fields: [trainerId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([trainerId, userId])
}

model Progress {
  id                 String   @id @default(uuid())
  userId             String
  weight             Float?
  waistCircumference Float?
  systolicBP         Int?
  diastolicBP        Int?
  restingHeartRate   Int?
  sleepHours         Float?
  proteinIntake      Float?
  cardioMinutes      Int?
  stressLevel        Int?
  bodyFat            Float?
  muscleMass         Float?
  workoutFrequency   Int?
  workoutDuration    Int?
  notes              String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Plan {
  id             String   @id @default(uuid())
  userId         String   @unique
  goal           FitnessGoal
  activity       ActivityType
  level          FitnessLevel
  calories       Int  @default(2000)
  protein        Int  @default(150)
  carbs          Int  @default(250)
  fats           Int  @default(70)
  workoutPlan    String
  meditationPlan String?
  supplementPlan String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model Conversation {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  messages     Message[]
  participants User[]    @relation("ConversationParticipants")
}

model DocumentEmbedding {
  id        String                @id @default(uuid())
  userId    String
  source    String
  content   String
  embedding Unsupported("vector")
  createdAt DateTime              @default(now())
}

model DietRecipeDetail {
  id        String   @id @default(uuid())
  userId    String
  meal      String
  mealKey   String
  items     String
  notes     String
  recipes   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealKey])
  @@index([userId, createdAt])
}

enum Role {
  USER
  TRAINER
}

enum TrainerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FitnessGoal {
  FAT_LOSS
  WEIGHT_GAIN
  MUSCLE_GAIN
  MAINTENANCE
  STRENGTH_INCREASE
  ENDURANCE_INCREASE
  FLEXIBILITY
  MOBILITY
  BALANCE
  ATHLETIC_PERFORMANCE
  PHYSICAL_REHABILITATION
}

enum ActivityType {
  WEIGHT_TRAINING
  BODYWEIGHT
  YOGA
  PILATES
  RUNNING
  WALKING
  HIKING
  CYCLING
  SWIMMING
  CROSSFIT
  HIIT
  DANCE
  MARTIAL_ARTS
  SPORTS
  HOME_WORKOUTS
  OUTDOOR_TRAINING
  MIXED_TRAINING
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ATHLETE
}


model GoalActivityRule {
  id        String        @id @default(uuid())

  goal      FitnessGoal
  activity  ActivityType
  minLevel  FitnessLevel

  @@unique([goal, activity])
  @@index([goal])
  @@index([goal, minLevel])
}
